{% set L = {
  de: {
    contact: "Kontakt",
    navTherapy: "Therapie & Beratung",
    navCouples: "Paartherapie & Beziehungsberatung",
    navIndividual: "Einzeltherapie & Beratung",
    navCoaching: "Coaching",
    navSupervision: "Supervision",
    navApproach: "Meine Arbeitsweise",
    navAbout: "Über mich",
    menuOpen: "Menü öffnen",
    footerImpressum: "Impressum",
    footerDatenschutz: "Datenschutz",
    footerMemberships: "Mitgliedschaften"
  },
  en: {
    contact: "Contact",
    navTherapy: "Therapy & Counseling",
    navCouples: "Couples Therapy & Relationship Counseling",
    navIndividual: "Individual Therapy & Counseling",
    navCoaching: "Coaching",
    navSupervision: "Supervision",
    navApproach: "My Approach",
    navAbout: "About Me",
    menuOpen: "Open menu",
    footerImpressum: "Legal Notice",
    footerDatenschutz: "Privacy Policy",
    footerMemberships: "Professional Memberships"
  }
} %}
{% set curLang = lang or 'de' %}
{% set t = L[curLang] %}
{% set prefix = '/en' if curLang == 'en' else '' %}
<!DOCTYPE html>
<html lang="{{ curLang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#20385c">
<title>{{ title }} · Stefan Gowitzke</title>
<meta name="description" content="{{ description }}">
<link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}?v={{ assetVersion.css }}">
</head>
<body>
<div class="header-sticky-group">
  <div class="utility-bar">
    <div class="lang-switch">
      {% if curLang == 'en' %}
        <a class="lang-link" href="{{ page.url.replace('/en/', '/') | url }}">DE</a><span class="sep">|</span><span class="lang-active">EN</span>
      {% else %}
        <span class="lang-active">DE</span><span class="sep">|</span>
        {% if hasTranslation == false %}
          <span class="is-disabled" style="opacity:.4;">EN</span>
        {% else %}
          <a class="lang-link" href="{{ ('/en' + page.url) | url }}">EN</a>
        {% endif %}
      {% endif %}
    </div>
    <div class="utility-contacts">
      <span class="utility-label">{{ t.contact }}</span>
      <a href="mailto:info@stefangowitzke.de">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        info@stefangowitzke.de
      </a>
      <a href="tel:+4915734640439">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        +49 157 34 64 04 39
      </a>
    </div>
  </div>
  <header class="site-header">
    <a class="brand" href="{{ (prefix + '/') | url }}">Stefan Gowitzke</a>
    <nav class="main-nav">
      <ul>
        <li class="has-dropdown">
          <a href="#">{{ t.navTherapy }}</a>
          <div class="dropdown">
            <a href="{{ (prefix + '/paartherapie/') | url }}">{{ t.navCouples }}</a>
            <a href="{{ (prefix + '/einzeltherapie/') | url }}">{{ t.navIndividual }}</a>
          </div>
        </li>
        <li><a href="{{ (prefix + '/coaching/') | url }}">{{ t.navCoaching }}</a></li>
        <li><a href="{{ (prefix + '/supervision/') | url }}">{{ t.navSupervision }}</a></li>
        <li><a href="{{ (prefix + '/ueber-mich/') | url }}" class="nav-plain">{{ t.navAbout }}</a></li>
      </ul>
    </nav>
    <button class="hamburger-btn" id="hamburgerBtn" aria-label="{{ t.menuOpen }}" aria-expanded="false" aria-controls="mobileNav">
      <span></span><span></span><span></span>
    </button>
  </header>
  <nav class="mobile-nav" id="mobileNav">
    <ul class="mobile-nav-list">
      <li class="mobile-nav-item">
        <button class="mobile-nav-toggle" aria-expanded="false">{{ t.navTherapy }}<span class="chevron"></span></button>
        <div class="mobile-nav-sub">
          <a href="{{ (prefix + '/paartherapie/') | url }}">{{ t.navCouples }}</a>
          <a href="{{ (prefix + '/einzeltherapie/') | url }}">{{ t.navIndividual }}</a>
        </div>
      </li>
      <li class="mobile-nav-item">
        <a class="mobile-nav-toggle mobile-nav-link" href="{{ (prefix + '/coaching/') | url }}">{{ t.navCoaching }}</a>
      </li>
      <li class="mobile-nav-item">
        <a class="mobile-nav-toggle mobile-nav-link" href="{{ (prefix + '/supervision/') | url }}">{{ t.navSupervision }}</a>
      </li>
      <li class="mobile-nav-item">
        <a class="mobile-nav-toggle mobile-nav-link" href="{{ (prefix + '/ueber-mich/') | url }}">{{ t.navAbout }}</a>
      </li>
      <li class="mobile-nav-item">
        <button class="mobile-nav-toggle" aria-expanded="false">{{ t.contact }}<span class="chevron"></span></button>
        <div class="mobile-nav-sub mobile-nav-sub-buttons">
          <a class="mobile-nav-link mobile-contact-btn" href="mailto:info@stefangowitzke.de"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>info@stefangowitzke.de</a>
          <a class="mobile-nav-link mobile-contact-btn" href="tel:+4915734640439"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 157 34 64 04 39</a>
        </div>
      </li>
    </ul>
  </nav>
</div>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div>© {{ currentYear }} Stefan Gowitzke</div>
  <div><a href="{{ '/impressum/' | url }}">{{ t.footerImpressum }}</a> · <a href="{{ '/datenschutz/' | url }}">{{ t.footerDatenschutz }}</a></div>
</footer>

<script src="{{ '/assets/js/main.js' | url }}?v={{ assetVersion.js }}"></script>
</body>
</html>
